# Firebase web app config (Firebase console > Project settings > Your apps). These identify the app; they are not
# secrets, but keep your own copy in .env, which git ignores.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# App Check. The hosted build uses a reCAPTCHA Enterprise site key. On your own machine the dev server uses App
# Check's debug provider: run `npm run dev`, copy the debug token Chrome's console prints, and register it in the
# Firebase console under App Check > Apps > Manage debug tokens. Never commit a debug token.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
VITE_APPCHECK_DEBUG=false
VITE_APPCHECK_DEBUG_TOKEN=
