# Firebase web app config (Firebase console > Project settings > Your apps). These identify the app; they are not
# secrets, but keep your own copy in .env, which git ignores.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# App Check. The hosted build uses a reCAPTCHA Enterprise site key.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# On your own machine `npm run dev` uses App Check's debug provider instead: copy the debug token Chrome's console
# prints and register it in the Firebase console under App Check > Apps > Manage debug tokens. To reuse one token,
# put it in .env.development.local as VITE_APPCHECK_DEBUG_TOKEN, never in .env: a production build reads .env.
