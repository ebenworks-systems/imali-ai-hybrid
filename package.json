{
  "name": "imali-ai-hybrid",
  "version": "0.1.0",
  "private": true,
  "description": "Imali AI book: a shop book read on the device by Gemini Nano through Firebase AI Logic, with a cloud second opinion when a check fails.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
